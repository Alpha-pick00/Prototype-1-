# DashScope(Alibaba Cloud) API 키. "gpt" 에이전트 슬롯이 실제로 호출하는 모델은
# Qwen이다 - platform.qwen.ai 또는 dashscope.console.aliyun.com에서 발급.
QWEN_API_KEY=
# 기본값은 국제(비중국 본토, "Model Studio") 엔드포인트. 중국 본토 DashScope
# 계정이면 https://dashscope.aliyuncs.com/compatible-mode/v1 로 바꿀 것. 계정이
# 워크스페이스 전용 게이트웨이(예: *.maas.aliyuncs.com)를 쓴다면 콘솔에서
# 확인한 그 주소로 바꿀 것.
QWEN_API_BASE=
# AI 상세검색(app/agents/deepseek.py::extract_facets_from_names)이 쓰는 키.
DEEPSEEK_API_KEY=
# console.groq.com에서 발급하는 무료 API 키 - OCR 텍스트 정리(app/ocr/cleanup.py)
# 전용. 기본 엔드포인트는 https://api.groq.com/openai/v1 (OpenAI 호환).
GROQ_API_KEY=
# CLOVA Studio(clovastudio.ncloud.com)에서 발급하는 키 - 검색어 표기 변형
# 폴백(app/agents/hcx.py::generate_query_variants) 전용. OpenAI 호환
# 엔드포인트(https://clovastudio.stream.ntruss.com/v1/openai)를 그대로 쓴다.
HCX_API_KEY=

# 11번가 오픈 API(openapi.11st.co.kr) 키. 메인 검색(app.debate.
# run_elevenst_only_debate)과 AI 상세검색이 쓴다 - 없으면 검색 결과가 항상
# 빈 리스트다.
ELEVENST_API_KEY=

GOOGLE_VISION_API_KEY=

# LLM 응답 캐시(app/llm_cache.py, KV+시맨틱) 저장소 - Supabase 프로젝트 URL과
# secret key(서버 쓰기용, RLS 우회 - publishable/anon 키가 아니라 secret 키를
# 써야 함). 스키마는 supabase/llm_cache.sql. 둘 다 없으면 캐시는 항상
# 미스로만 동작한다(나머지 파이프라인은 정상 동작).
SUPABASE_URL=
SUPABASE_KEY=

# 소셜 로그인 (Google Client ID는 frontend/.env.example의 VITE_GOOGLE_CLIENT_ID 참고 —
# 백엔드는 access_token으로 유저 정보를 조회해서 client id가 필요 없음)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SESSION_SECRET_KEY=
