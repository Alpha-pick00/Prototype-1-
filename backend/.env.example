# DashScope(Alibaba Cloud) API 키. "gpt" 에이전트 슬롯이 실제로 호출하는 모델은
# Qwen이다 - platform.qwen.ai 또는 dashscope.console.aliyun.com에서 발급.
QWEN_API_KEY=
# 기본값은 국제(비중국 본토, "Model Studio") 엔드포인트. 중국 본토 DashScope
# 계정이면 https://dashscope.aliyuncs.com/compatible-mode/v1 로 바꿀 것. 계정이
# 워크스페이스 전용 게이트웨이(예: *.maas.aliyuncs.com)를 쓴다면 콘솔에서
# 확인한 그 주소로 바꿀 것.
QWEN_API_BASE=
# CLOVA Studio(Naver Cloud, HCX)에서 발급하는 API 키 - "groq" 에이전트 슬롯
# (정제/제안 일부/심사/스타일가이드/카테고리분류/OCR정제)이 실제로 호출하는
# 모델(app/config.py 참고, 2026-08-21부터). Bearer 토큰 하나면 되고 별도 헤더는
# 필요 없다.
HCX_API_KEY=
# 기본값은 https://clovastudio.stream.ntruss.com/v1/openai (OpenAI 호환 엔드포인트).
HCX_API_BASE=
# 예전에 Groq를 쓰던 흔적 - 지금은 코드가 안 읽지만 롤백 대비로 남겨둔다.
GROQ_API_KEY=
# AI 상세검색(app/agents/deepseek.py::extract_facets_from_names)도 이 키를 그대로 쓴다.
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
# openapi.11st.co.kr에서 발급하는 오픈API 키. app.search.search()의 기본 검색
# 백엔드이자 adk_pipeline._ElevenstFetchNode의 자격증명 - 미설정이어도
# 서버는 죽지 않고 검색/해당 후보 없이 조용히 스킵된다.
ELEVENST_API_KEY=

GOOGLE_VISION_API_KEY=

# 소셜 로그인 (Google Client ID는 frontend/.env.example의 VITE_GOOGLE_CLIENT_ID 참고 —
# 백엔드는 access_token으로 유저 정보를 조회해서 client id가 필요 없음)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SESSION_SECRET_KEY=
